# ============================================================
# Campusly Frontend (studyapp) - Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# ============================================================

# Backend API URL (Use localhost, LAN IP for physical device, or production Vercel URL)
EXPO_PUBLIC_API_URL=http://localhost:5000

# OpenRouter AI Configuration for Frontend Chat / Assistant
EXPO_PUBLIC_OPENROUTER_API_KEY=your_openrouter_api_key_here
EXPO_PUBLIC_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EXPO_PUBLIC_OPENROUTER_MODEL=openrouter/free
