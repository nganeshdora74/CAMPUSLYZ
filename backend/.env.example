# ============================================================
# Campusly Backend - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# ============================================================

# Server Port
PORT=5000

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# MongoDB Connection URI (Local or Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/campusly?retryWrites=true&w=majority

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

